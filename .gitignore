# Kotlin incremental build cache
.kotlin/

# Signing keystores. "opbr companion.jks" lives in the project root and was
# untracked only by luck — nothing was stopping a `git add -A` from publishing
# the key that signs every release. Losing control of it means someone else can
# sign an update as you, and Play will not let you rotate away from it easily.
*.jks
*.keystore
keystore.properties

# Release output. Regenerated by every build, ~13MB of binary per copy, and
# nothing reads it back out of the repo.
/release/
